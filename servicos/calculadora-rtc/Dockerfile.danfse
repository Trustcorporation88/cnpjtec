# Gerador oficial do DANFSe (PDF da NFS-e) da Receita Federal.
# Código MIT em github.com/ReceitaFederal/calculadora-rtc-gerador-danfse, commit fixado.
# Serviço interno: sem domínio público.
ARG COMMIT_DANFSE=8d79e6b2f7fad6375340afcb51c85ed370c64a14

FROM golang:1.27.1 AS build
ARG COMMIT_DANFSE
RUN git clone https://github.com/ReceitaFederal/calculadora-rtc-gerador-danfse /app \
 && git -C /app checkout --quiet "$COMMIT_DANFSE"
WORKDIR /app
RUN go mod download \
 && go install github.com/swaggo/swag/cmd/swag@v1.16.6 \
 && /go/bin/swag init -g cmd/danfse/main.go -o ./api/swagger \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o danfse-service ./cmd/danfse

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=America/Sao_Paulo SERVER_PORT=8080 XML_MAX_SIZE_BYTES=1048576
WORKDIR /app
COPY --from=build /app/danfse-service .
EXPOSE 8080
ENTRYPOINT ["./danfse-service"]
