# Imagem do site (apps/web), montada no GitHub Actions e publicada no GHCR.
# O Railway sobe o serviço "web" a partir dela. As chaves ficam nas variáveis do Railway,
# nunca na imagem: as páginas e rotas que dependem delas são dinâmicas.
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cnpjtec/web build

FROM base
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 8080
CMD ["sh", "-c", "pnpm --filter @cnpjtec/web exec next start -p ${PORT:-8080}"]
